# ========================================================
# EDU TRACK - GO FIBER BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=8080

# Supabase PostgreSQL Connection String (Transaction Pooler / Session mode)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-supabase-ref.supabase.co:5432/postgres

# Supabase API & Storage Configuration
SUPABASE_URL=https://your-supabase-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=audit-citizen-photos

# Environment
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

